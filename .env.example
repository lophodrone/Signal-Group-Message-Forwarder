# The phone number of the Signal account the bot runs as (must be a member of both groups)
SIGNAL_NUMBER=+15551234567

# Group names, "group.xxx" ids, or internal ids — see: docker compose run --rm forwarder python forwarder.py --list-groups
SOURCE_GROUP=Source Group Name
# TARGET_GROUP can list several groups separated by commas
TARGET_GROUP=Target Group Name, Another Group
# Also forward from the target group(s) back to the source group
BIDIRECTIONAL=false

# --- OR, instead of the three lines above, define routes directly ---
# "->" forwards one way, "<->" both ways; separate routes with ";"
# ROUTES=Group A <-> Group B
# ROUTES=Announcements -> Team A, Team B; Team A <-> Team B

# Show which group a forwarded message came from: "Alice [Group A]: hi"
PREFIX_GROUP=false

# Optional
# false = forward only the message content, without the sender's name
PREFIX_SENDER=false
# Edits in the source group update the forwarded copy
FORWARD_EDITS=true
# DEBUG logs every raw event from the API (useful for troubleshooting)
LOG_LEVEL=INFO

# When a message is deleted for everyone in a source group, delete the forwarded copies too
FORWARD_DELETES=true
# How long (days) to remember forwarded messages for this
MAP_RETENTION_DAYS=7
